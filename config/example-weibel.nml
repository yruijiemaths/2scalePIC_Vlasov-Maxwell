&pic
  ! Small runnable example; not the production input used for paper figures.
  cfg_initial_condition = 2
  cfg_particles_per_cell = 10000
  cfg_nx = 32
  cfg_nvx = 40
  cfg_nvy = 40
  cfg_ntau = 16

  cfg_domain_length = 6.283185307179586d0
  cfg_velocity_x_length = 12.0d0
  cfg_velocity_y_length = 12.0d0
  cfg_epsilon = 2.5d-2
  cfg_dt = 5.0d-2
  cfg_tfinal = 1.0d0

  cfg_density_perturbation = 5.0d-2
  cfg_weibel_sigma_vx = 1.0d0
  cfg_weibel_sigma_vy = 2.0d0
  cfg_wave_number = 1.0d0
  cfg_bz_weibel = 1.0d-2
/

&pic_output
  cfg_output_fxvx = .true.
  cfg_output_fvxvy = .true.
  cfg_output_rho = .false.
  cfg_output_rhov = .false.
  cfg_output_fields = .false.
  cfg_output_mass = .true.
  cfg_output_charge = .true.
  cfg_output_energy = .true.
  cfg_output_kinetic_components = .true.
  cfg_output_field_l2 = .true.
  cfg_output_poisson = .true.
  cfg_output_poisson_tau = .true.
  cfg_output_momentum = .true.
  cfg_output_initial = .true.
  cfg_output_final = .true.
  cfg_snapshot_interval = 0.5d0
  cfg_diagnostic_interval_steps = 1
  cfg_output_prefix = 'example_weibel'
/
